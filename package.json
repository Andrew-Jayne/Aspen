{
  "name": "aspen",
  "version": "v1beta5",
  "module": "src/index.ts",
  "main": "dist/aspen.min.js",
  "types": "dist/aspen.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/aspen.min.js"
    },
    "./dist/aspen.ts": "./dist/aspen.ts",
    "./dist/aspen.min.js": "./dist/aspen.min.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.ts && bun scripts/bundle-ts.ts",
    "lint": "biome check src/ && explicitjs src/",
    "format": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "explicitjs": "https://github.com/Andrew-Jayne/ExplicitJS/releases/download/v1beta5/explicitjs-1beta5.tgz"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrew-Jayne/Aspen"
  }
}
