{
  "name": "aspen",
  "version": "v1beta5",
  "module": "src/index.ts",
  "main": "dist/aspen.min.js",
  "types": "dist/aspen.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/aspen.min.js"
    },
    "./dist/aspen.ts": "./dist/aspen.ts",
    "./dist/aspen.min.js": "./dist/aspen.min.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/bundle-js.ts && node scripts/bundle-ts.ts",
    "build:ts-only": "node scripts/bundle-ts.ts",
    "build:js-only": "node scripts/bundle-js.ts",
    "typecheck": "tsc",
    "lint": "biome check --write src/ && explicitjs src/"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "^26",
    "esbuild": "^0.28.2",
    "explicitjs": "https://github.com/Andrew-Jayne/ExplicitJS/releases/download/v1beta5/explicitjs-1beta5.tgz",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrew-Jayne/Aspen"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
